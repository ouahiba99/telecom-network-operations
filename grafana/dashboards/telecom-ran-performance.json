    {
      "id": 11,
      "type": "table",
      "title": "RAN Cells Requiring Attention",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "telecom-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "telecom-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "\n        WITH latest AS (\n            SELECT DISTINCT ON (cell_db_id)\n                *\n            FROM network_kpis\n            ORDER BY cell_db_id, timestamp DESC\n        )\n        SELECT\n            cell_id AS \"Cell\",\n            radio AS \"Radio\",\n            ROUND(rrc_success_rate::numeric, 2) AS \"RRC %\",\n            ROUND(handover_success_rate::numeric, 2) AS \"HO %\",\n            ROUND(call_drop_rate::numeric, 2) AS \"Drop %\",\n            ROUND(latency_ms::numeric, 2) AS \"Latency ms\",\n            ROUND(packet_loss_pct::numeric, 2) AS \"Loss %\",\n            CASE\n                WHEN rrc_success_rate < 90\n                  OR handover_success_rate < 90\n                  OR call_drop_rate > 5\n                THEN 'CRITICAL'\n                WHEN rrc_success_rate < 95\n                  OR handover_success_rate < 94\n                  OR call_drop_rate > 2\n                THEN 'WARNING'\n                ELSE 'HEALTHY'\n            END AS \"Status\"\n        FROM latest\n        WHERE rrc_success_rate < 95\n           OR handover_success_rate < 94\n           OR call_drop_rate > 2\n        ORDER BY rrc_success_rate ASC\n        LIMIT 20;\n        "
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true,
        "sortBy": []
      }
    }
