    },
    {
      "id": 9,
      "type": "table",
      "title": "Top Congested Cells",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "telecom-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "telecom-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "\n        WITH latest AS (\n            SELECT DISTINCT ON (cell_db_id)\n                *\n            FROM network_kpis\n            ORDER BY cell_db_id, timestamp DESC\n        )\n        SELECT\n            cell_id AS \"Cell\",\n            radio AS \"Radio\",\n            ROUND(prb_utilization_pct::numeric, 2) AS \"PRB %\",\n            active_users AS \"Active Users\",\n            ROUND(throughput_mbps::numeric, 2) AS \"Throughput Mbps\",\n            ROUND(latency_ms::numeric, 2) AS \"Latency ms\",\n            ROUND(packet_loss_pct::numeric, 2) AS \"Packet Loss %\",\n            ROUND(availability::numeric, 2) AS \"Availability %\",\n            CASE\n                WHEN prb_utilization_pct > 95 THEN 'CRITICAL'\n                WHEN prb_utilization_pct > 90 THEN 'WARNING'\n                ELSE 'NORMAL'\n            END AS \"Capacity Status\"\n        FROM latest\n        WHERE prb_utilization_pct > 80\n        ORDER BY prb_utilization_pct DESC\n        LIMIT 20;\n        "
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true,
        "sortBy": []
      }
