          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\n        SELECT\n            date_trunc('minute', timestamp) AS time,\n            AVG(active_users) AS \"Active Users\"\n        FROM network_kpis\n        WHERE $__timeFilter(timestamp)\n        GROUP BY 1\n        ORDER BY 1;\n        "
