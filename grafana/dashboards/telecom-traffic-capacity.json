    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency vs Utilization",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "telecom-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "telecom-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\n        SELECT\n            date_trunc('minute', timestamp) AS time,\n            AVG(latency_ms) AS \"Latency ms\",\n            AVG(prb_utilization_pct) AS \"PRB %\"\n        FROM network_kpis\n        WHERE $__timeFilter(timestamp)\n        GROUP BY 1\n        ORDER BY 1;\n        "
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
