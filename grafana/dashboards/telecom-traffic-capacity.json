          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "telecom-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "\n        WITH latest AS (\n            SELECT DISTINCT ON (cell_db_id)\n                *\n            FROM network_kpis\n            ORDER BY cell_db_id, timestamp DESC\n        )\n        SELECT COUNT(*) AS value\n        FROM latest\n        WHERE prb_utilization_pct > 90;\n        "
        }
