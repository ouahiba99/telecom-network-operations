  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Critical Signals",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "telecom-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "telecom-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "\n        WITH latest AS (\n            SELECT DISTINCT ON (cell_db_id)\n                *\n            FROM network_kpis\n            ORDER BY cell_db_id, timestamp DESC\n        )\n        SELECT COUNT(*) AS value\n        FROM latest\n        WHERE availability < 95\n           OR latency_ms > 120\n           OR packet_loss_pct > 5\n           OR prb_utilization_pct > 95\n           OR call_drop_rate > 5\n           OR rrc_success_rate < 90\n           OR handover_success_rate < 90;\n        "
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Warning Signals",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "telecom-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "telecom-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "\n        WITH latest AS (\n            SELECT DISTINCT ON (cell_db_id)\n                *\n            FROM network_kpis\n            ORDER BY cell_db_id, timestamp DESC\n        )\n        SELECT COUNT(*) AS value\n        FROM latest\n        WHERE (\n            availability < 98\n            OR latency_ms > 80\n            OR packet_loss_pct > 2\n            OR prb_utilization_pct > 90\n            OR call_drop_rate > 2\n            OR rrc_success_rate < 95\n            OR handover_success_rate < 94\n        )\n        AND NOT (\n            availability < 95\n            OR latency_ms > 120\n            OR packet_loss_pct > 5\n            OR prb_utilization_pct > 95\n            OR call_drop_rate > 5\n            OR rrc_success_rate < 90\n            OR handover_success_rate < 90\n        );\n        "
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cells Affected",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "telecom-postgres"
      },
      "targets": [
