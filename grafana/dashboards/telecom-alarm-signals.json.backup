          "datasource": {
            "type": "postgres",
            "uid": "telecom-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\n        SELECT\n            date_trunc('minute', timestamp) AS time,\n            AVG(prb_utilization_pct) AS \"PRB\",\n            90 AS \"Warning Threshold\",\n            95 AS \"Critical Threshold\"\n        FROM network_kpis\n        WHERE $__timeFilter(timestamp)\n        GROUP BY 1\n        ORDER BY 1;\n        "
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
