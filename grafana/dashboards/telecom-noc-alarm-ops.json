    {
      "id": 7,
      "type": "stat",
      "title": "\u23f1  Avg MTTA (s)",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "telecom-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "telecom-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "\n        SELECT ROUND(\n            AVG(\n                EXTRACT(EPOCH FROM (acknowledged_at - created_at))\n            ) FILTER (WHERE acknowledged_at IS NOT NULL\n                        AND created_at    IS NOT NULL)::numeric,\n            1\n        ) AS value\n        FROM network_alarms;\n        "
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
